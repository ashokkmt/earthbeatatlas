# Local-only defaults. Replace before any non-local deployment.
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=postgis

# Local S3-compatible object store profile only. Change before starting it.
S3_ACCESS_KEY_ID=local-dev-access
S3_SECRET_ACCESS_KEY=replace-with-a-long-random-local-secret
S3_ENDPOINT_URL=http://localhost:8333
S3_BUCKET=nisar-assets

# Optional for bounded source ingestion when a local .netrc is not available.
# Generate an Earthdata user token in your profile; never expose it to the browser.
EARTHDATA_TOKEN=
