# Copy to infra/cloud/.env and set strong unique secrets. Never commit .env.
PUBLIC_DOMAIN=earthbeat.example.org
POSTGRES_USER=earthbeat
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=postgis
# URL-encode special characters in the password.
DATABASE_URL=postgresql://earthbeat:replace-with-a-long-random-password@db:5432/postgis
S3_BUCKET=earthbeat-assets
S3_ENDPOINT_URL=
AWS_DEFAULT_REGION=us-east-1
TITILER_S3_ENDPOINT=s3.amazonaws.com
S3_VIRTUAL_HOSTING=true
S3_READ_ACCESS_KEY_ID=replace-with-read-only-key
S3_READ_SECRET_ACCESS_KEY=replace-with-read-only-secret
S3_ACCESS_KEY_ID=replace-with-read-write-service-key
S3_SECRET_ACCESS_KEY=replace-with-service-secret
EARTHDATA_TOKEN=
CORS_ORIGINS=https://earthbeat.example.org
# Leave processing disabled until an authentication/rate-limit gateway is installed.
ENABLE_PROCESSING_JOBS=false
