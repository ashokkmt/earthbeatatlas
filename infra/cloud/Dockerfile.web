FROM node:24-alpine AS build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
ARG VITE_STAC_BASE=/stac
ARG VITE_PROJECT_API=/api
ARG VITE_TILES_BASE=/api/v1/tiles
ENV VITE_STAC_BASE=$VITE_STAC_BASE VITE_PROJECT_API=$VITE_PROJECT_API VITE_TILES_BASE=$VITE_TILES_BASE
RUN npm run build

FROM caddy:2.10-alpine
COPY infra/cloud/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /web/dist /srv
EXPOSE 80 443 443/udp
